<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wariant pokazowy nie ma uprawnienia sieciowego i nie może pobierać
         danych z backendu. Linki nawigacyjne są przekazywane do zewnętrznej
         aplikacji mapowej przez Intent. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

</manifest>
